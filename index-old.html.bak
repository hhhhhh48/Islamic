<canvas id="confetti-canvas"></canvas>

<!-- ═══ CERTIFICATE OVERLAY — Premium Design ═══ -->
<div class="cert-overlay" id="certOverlay">

  <!-- STEP 1: Form -->
  <div class="cert-form" id="certForm">
    <div class="cert-form-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </div>
    <h3 class="cert-form-title" data-i18n="cert_form_title">مبارك عليك 🤍</h3>
    <p class="cert-form-sub" data-i18n="cert_form_sub">أدخل اسمك لنُصدر لك شهادة إسلامك الرقمية</p>
    
    <label for="firstName" data-i18n="cert_form_first">الاسم الأول</label>
    <input type="text" id="firstName" maxlength="30" placeholder="محمد، أحمد...">
    
    <label for="lastName" data-i18n="cert_form_last">اللقب (اختياري)</label>
    <input type="text" id="lastName" maxlength="30" placeholder="العبد، الخالدي...">
    
    <div class="cert-form-actions">
      <button class="btn-cert-ghost" id="certCancel" data-i18n="cert_form_cancel">إلغاء</button>
      <button class="btn-cert-primary" id="certConfirm" data-i18n="cert_form_confirm">استلم الشهادة</button>
    </div>
  </div>

  <!-- STEP 2: Certificate -->
  <div id="certStep2" style="display:none; width:100%; display:none;">
    <div class="certificate" id="certificate">
      <!-- Corner ornaments -->
      <div class="cert-corner tl">
        <svg viewBox="0 0 100 100" fill="none" stroke="#a67c3c" stroke-width="1">
          <path d="M0 20 Q20 20 20 0 M0 40 Q40 40 40 0 M0 60 Q60 60 60 0"/>
          <circle cx="20" cy="20" r="3" fill="#c9a961"/>
        </svg>
      </div>
      <div class="cert-corner tr">
        <svg viewBox="0 0 100 100" fill="none" stroke="#a67c3c" stroke-width="1">
          <path d="M0 20 Q20 20 20 0 M0 40 Q40 40 40 0 M0 60 Q60 60 60 0"/>
          <circle cx="20" cy="20" r="3" fill="#c9a961"/>
        </svg>
      </div>
      <div class="cert-corner bl">
        <svg viewBox="0 0 100 100" fill="none" stroke="#a67c3c" stroke-width="1">
          <path d="M0 20 Q20 20 20 0 M0 40 Q40 40 40 0 M0 60 Q60 60 60 0"/>
          <circle cx="20" cy="20" r="3" fill="#c9a961"/>
        </svg>
      </div>
      <div class="cert-corner br">
        <svg viewBox="0 0 100 100" fill="none" stroke="#a67c3c" stroke-width="1">
          <path d="M0 20 Q20 20 20 0 M0 40 Q40 40 40 0 M0 60 Q60 60 60 0"/>
          <circle cx="20" cy="20" r="3" fill="#c9a961"/>
        </svg>
      </div>

      <!-- Watermark -->
      <div class="cert-watermark"></div>

      <!-- Inner gold border -->
      <div class="cert-inner-border"></div>

      <!-- Rank badge -->
      <div class="cert-rank-badge" id="certRank">#1</div>

      <!-- Content -->
      <div class="cert-content">

        <!-- Bismillah -->
        <div class="cert-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>

        <!-- Top ornament -->
        <div class="cert-top-ornament">✦</div>

        <!-- Main title -->
        <h1 class="cert-main-title">شهادة إسلام</h1>
        <div class="cert-subtitle-en">Certificate of Shahada</div>

        <!-- Decorative line -->
        <div class="cert-line">❁</div>

        <!-- Witness text -->
        <div class="cert-witness">تشهد هذه الوثيقة بأن</div>

        <!-- Name -->
        <div class="cert-name-wrap">
          <div class="cert-name-bg"></div>
          <div class="cert-name" id="certNameDisplay">—</div>
        </div>

        <!-- Body -->
        <div class="cert-body">
          قد نطق بشهادتَي الإسلام بيقينٍ وقلبٍ حاضر،<br>
          فأسلم لله ربّ العالمين، وبدأ صفحةً جديدةً نقيةً بيضاء.<br>
          نسأل الله أن يثبّته على دينه، ويهديه صراطاً مستقيماً.
        </div>

        <!-- Seal -->
        <div class="cert-seal-wrap">
          <div class="cert-seal">
            <svg class="cert-seal-ring" viewBox="0 0 120 120">
              <defs>
                <path id="sealCircle" d="M 60,60 m -48,0 a 48,48 0 1,1 96,0 a 48,48 0 1,1 -96,0"/>
              </defs>
              <circle cx="60" cy="60" r="52" fill="none" stroke="#a67c3c" stroke-width="1.5"/>
              <circle cx="60" cy="60" r="48" fill="none" stroke="#c9a961" stroke-width=".8"/>
              <circle cx="60" cy="60" r="38" fill="none" stroke="#c9a961" stroke-width=".6" stroke-dasharray="2,3"/>
              <text font-family="Amiri, serif" font-size="8" fill="#a67c3c" letter-spacing="1">
                <textPath href="#sealCircle" startOffset="0%">
                  ✦ أشهد أن لا إله إلا الله ✦ محمد رسول الله ✦
                </textPath>
              </text>
            </svg>
            <div class="cert-seal-center">ﷲ</div>
          </div>
        </div>

        <!-- Meta -->
        <div class="cert-meta">
          <div class="cert-meta-item">
            <div class="lbl">DATE</div>
            <div class="val ar" id="certDateAr">—</div>
          </div>
          <div class="cert-meta-item">
            <div class="lbl">CERTIFICATE NO.</div>
            <div class="val" id="certNumber">SHA-000000</div>
          </div>
          <div class="cert-meta-item">
            <div class="lbl">ISSUED AT</div>
            <div class="val">mohammedouachemi.work.gd</div>
          </div>
        </div>

      </div>
    </div>

    <!-- Actions below certificate -->
    <div class="cert-actions">
      <button class="cert-action-btn cert-dl" id="certDownload">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
        تحميل PNG
      </button>
      <button class="cert-action-btn cert-share-wa" id="certShareWa">
        <svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
        </svg>
        واتساب
      </button>
      <button class="cert-action-btn cert-close" id="certClose">إغلاق</button>
    </div>
  </div>

</div>


<div class="toast" id="toast">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
  <div><div class="toast-ar" data-i18n="toast_title"></div><div class="toast-en" data-i18n="toast_sub"></div></div>
</div>
<script src="i18n.js"></script>
<script src="app.js"></script>
<script src="share.js"></script>
<script src="stamp.js"></script>
</body>
</html>
